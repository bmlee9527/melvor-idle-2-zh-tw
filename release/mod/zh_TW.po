msgid "Ashen Lands Trail"
msgstr "灰燼之地小徑"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid "Unlocks the [color=#FFD16D]Ashen Tree[/color] in Woodcutting which provide [color=#FFD16D]Ashen Logs[/color] used in various areas of the game."
msgstr "解鎖伐木技能中的[color=#FFD16D]灰燼樹[/color]。砍伐灰燼樹可獲得[color=#FFD16D]灰燼原木[/color]，在遊戲中有多種用途。"

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Dense Cave Trail"
msgstr "密巖洞窟小徑"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid "Unlocks the [color=#FFD16D]Dense Coal Rock[/color] in Mining which is a much more efficient source of [color=#FFD16D]Coal[/color]."
msgstr "解鎖採礦技能中的[color=#FFD16D]緻密煤巖[/color]。開採這種礦石能更高效地獲得[color=#FFD16D]煤炭[/color]。"

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Torag Grounds Trail"
msgstr "托拉格棲息地小徑"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid "Unlocks the [color=#FFD16D]Torag Grounds[/color] Location in Hunting, allowing you to hunt [color=#FFD16D]Torag[/color] which drop materials for high-level gear."
msgstr "解鎖狩獵地點[color=#FFD16D]托拉格棲息地[/color]。在這裡獵殺[color=#FFD16D]托拉格[/color]，可獲得製作進階裝備的材料。"

